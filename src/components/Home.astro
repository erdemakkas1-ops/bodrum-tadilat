---
import Base from '../layouts/Base.astro';
import Photo from './Photo.astro';
import Logo from './Logo.astro';
import { business, copy, type Lang } from '../content';
import { img } from '../images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const wa = `https://wa.me/${business.whatsapp}?text=${encodeURIComponent(t.contact.form.greeting)}`;
const pad = (n: number) => String(n).padStart(2, '0');

const pairImgs = [
  { before: img['cephe-once'], after: img['cephe-sonra'] },
  { before: img['mutfak-once'], after: img['mutfak-sonra'] },
];
const galleryKeys = ['kemer', 'yikim', 'begonvil', 'usta', 'villa', 'kapi', 'pencere', 'avlu'] as const;
const galleryImg: Record<(typeof galleryKeys)[number], string> = {
  kemer: 'g-kemer', yikim: 'g-yikim', begonvil: 'g-begonvil', usta: 'g-seramik-usta',
  villa: 'g-villa', kapi: 'g-kapi', pencere: 'g-pencere', avlu: 'g-avlu',
};
const processImg = ['surec-1-kazima', 'surec-2-sap', 'surec-3-kat1', 'surec-4-kat2', 'surec-5-kece', 'surec-6-likit', 'surec-7-sonuc'];
---
<Base lang={lang}>
  <header class="site-header">
    <div class="wrap header-row">
      <a class="brand" href={lang === 'tr' ? '/' : '/en/'} aria-label={business.name}>
        <Logo />
      </a>
      <nav class="nav" aria-label={lang === 'tr' ? 'Ana menü' : 'Main menu'}>
        <a href="#isler">{t.nav.work}</a>
        <a href="#hizmetler">{t.nav.services}</a>
        <a href="#surec">{t.nav.process}</a>
        <a href="#iletisim">{t.nav.contact}</a>
      </nav>
      <div class="header-actions">
        <a class="lang" href={t.nav.otherHref} hreflang={lang === 'tr' ? 'en' : 'tr'} aria-label={t.nav.otherLabel}>{t.nav.other}</a>
        <a class="btn btn-ink btn-sm" href={business.phoneHref}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
          <span class="hide-sm">{business.phoneDisplay}</span><span class="show-sm">{t.nav.call}</span>
        </a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="kicker reveal">{t.hero.kicker}</p>
          <h1 class="hero-title reveal">
            <span>{t.hero.titleA}</span>
            <span><em>{t.hero.titleEm}</em> {t.hero.titleB}</span>
          </h1>
          <p class="hero-lead reveal">{t.hero.lead}</p>
          <div class="hero-ctas reveal">
            <a class="btn btn-terra" href={wa} target="_blank" rel="noopener">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
              {t.hero.ctaPrimary}
            </a>
            <a class="link-arrow" href="#isler">{t.hero.ctaSecondary} <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <figure class="hero-figure">
          <div class="hero-photo">
            <Photo src={img['hero-teras']} alt={t.hero.imgAlt} sizes="(min-width: 960px) 52vw, 100vw" loading="eager" fetchpriority="high" />
          </div>
          <div class="hero-before" aria-hidden="false">
            <Photo src={img['ba-teras2-once']} alt={t.hero.beforeAlt} sizes="180px" widths={[240, 400]} loading="eager" />
            <span class="tag">{t.hero.beforeLabel}</span>
          </div>
          <figcaption class="hero-caption">
            <strong>{t.hero.captionTitle}</strong>
            <span>{t.hero.captionQuote}</span>
          </figcaption>
        </figure>
      </div>

      <ul class="wrap promises" role="list">
        {t.promises.map((p, i) => <li class="draw"><span class="num">{pad(i + 1)}</span>{p}</li>)}
      </ul>
    </section>

    <!-- BEFORE / AFTER -->
    <section class="ba section" id="isler" aria-labelledby="ba-title">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">{t.ba.kicker}</p>
          <h2 id="ba-title" class="h2 reveal">{t.ba.title}</h2>
        </div>

        <div class="ba-stage" data-ba-tabs>
          <div class="ba-tabs" role="tablist" aria-label={t.ba.kicker}>
            {t.ba.projects.map((p, i) => (
              <button role="tab" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                <span class="num">{pad(i + 1)}</span>{p.tab}
              </button>
            ))}
          </div>

          {t.ba.projects.map((p, i) => (
            <div class="ba-panel" role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0}>
              <div class="compare" style="--pos: 50%">
                <Photo class="compare-after" src={img[`ba-${p.id}-sonra`]} alt={p.afterAlt} sizes="(min-width: 960px) 560px, 100vw" widths={[480, 800, 1120]} />
                <div class="compare-before">
                  <Photo src={img[`ba-${p.id}-once`]} alt={p.beforeAlt} sizes="(min-width: 960px) 560px, 100vw" widths={[480, 800, 1120]} />
                </div>
                <span class="compare-line" aria-hidden="true"><span class="compare-knob">⟷</span></span>
                <span class="tag tag-l" aria-hidden="true">{t.ba.before}</span>
                <span class="tag tag-r" aria-hidden="true">{t.ba.after}</span>
                <input class="compare-range" type="range" min="0" max="100" value="50" aria-label={`${t.ba.sliderLabel}: ${p.title}`} />
              </div>
              <div class="ba-text">
                <p class="num big">{pad(i + 1)}<span>/{pad(t.ba.projects.length)}</span></p>
                <h3 class="h3">{p.title}</h3>
                <p>{p.text}</p>
                <p class="hint">{t.ba.hint}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="pairs">
          {t.ba.pairs.map((p, i) => (
            <article class="pair">
              <div class="pair-imgs">
                <figure class="wipe">
                  <Photo src={pairImgs[i].before} alt={p.beforeAlt} sizes="(min-width: 960px) 22vw, 50vw" widths={[320, 560, 800]} />
                  <span class="tag">{t.ba.before}</span>
                </figure>
                <figure class="wipe">
                  <Photo src={pairImgs[i].after} alt={p.afterAlt} sizes="(min-width: 960px) 22vw, 50vw" widths={[320, 560, 800]} />
                  <span class="tag tag-light">{t.ba.after}</span>
                </figure>
              </div>
              <h3 class="h3">{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="services section" id="hizmetler" aria-labelledby="sv-title">
      <div class="wrap services-grid">
        <div class="services-list">
          <p class="kicker">{t.services.kicker}</p>
          <h2 id="sv-title" class="h2 reveal">{t.services.title}</h2>
          <p class="intro">{t.services.intro}</p>
          <ol class="sv" role="list">
            {t.services.items.map((s, i) => (
              <li class="sv-item draw" data-key={s.key} tabindex="0">
                <span class="num">{pad(i + 1)}</span>
                <div>
                  <h3 class="sv-title">{s.title}</h3>
                  <p>{s.text}</p>
                </div>
                <div class="sv-thumb wipe">
                  <Photo src={img[`hizmet-${s.key}`]} alt={s.alt} sizes="(min-width: 960px) 1px, 34vw" widths={[320, 560]} />
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="services-visual" aria-hidden="true">
          <div class="sv-frame">
            {t.services.items.map((s, i) => (
              <div class="sv-slide" data-key={s.key} data-active={i === 0 ? 'true' : 'false'}>
                <Photo src={img[`hizmet-${s.key}`]} alt="" sizes="(min-width: 960px) 40vw, 1px" widths={[640, 960, 1280]} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="process section" id="surec" aria-labelledby="pr-title">
      <div class="wrap process-head">
        <div>
          <p class="kicker">{t.process.kicker}</p>
          <h2 id="pr-title" class="h2 reveal">{t.process.title}</h2>
        </div>
        <div class="process-side">
          <p class="intro">{t.process.intro}</p>
          <div class="process-nav">
            <button class="round" data-dir="-1" aria-label={t.process.prev}>←</button>
            <button class="round" data-dir="1" aria-label={t.process.next}>→</button>
          </div>
        </div>
      </div>
      <ol class="steps" role="list" tabindex="0" aria-label={t.process.title}>
        {t.process.steps.map((s, i) => (
          <li class="step">
            <div class="step-img wipe">
              <Photo src={img[processImg[i]]} alt={s.alt} sizes="(min-width: 960px) 30vw, 78vw" widths={[400, 640, 960]} />
            </div>
            <p class="num">{pad(i + 1)}</p>
            <h3 class="h3">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- GALLERY -->
    <section class="gallery section" aria-labelledby="gl-title">
      <div class="wrap">
        <div class="section-head row">
          <div>
            <p class="kicker">{t.gallery.kicker}</p>
            <h2 id="gl-title" class="h2 reveal">{t.gallery.title}</h2>
          </div>
          <a class="link-arrow" href={business.instagram} target="_blank" rel="noopener">{t.gallery.more} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="g-grid">
          {galleryKeys.map((k, i) => (
            <figure class={`g g-${i + 1} wipe`}>
              <Photo src={img[galleryImg[k]]} alt={t.gallery.items[k]} sizes="(min-width: 960px) 30vw, 50vw" widths={[400, 640, 960]} />
              <figcaption>{t.gallery.items[k]}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- AREA -->
    <section class="area section" aria-labelledby="ar-title">
      <div class="wrap area-grid">
        <div>
          <p class="kicker">{t.area.kicker}</p>
          <h2 id="ar-title" class="h2 reveal">{t.area.title}</h2>
          <p class="intro">{t.area.note}</p>
        </div>
        <ul class="places" role="list">
          {t.area.places.map((p, i) => <li class={i === 0 ? 'home' : ''}>{p}</li>)}
        </ul>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact" id="iletisim" aria-labelledby="ct-title">
      <div class="wrap contact-grid">
        <div class="contact-copy">
          <p class="kicker">{t.contact.kicker}</p>
          <h2 id="ct-title" class="h2">{t.contact.title}</h2>
          <p class="intro">{t.contact.lead}</p>
          <dl class="channels">
            <div>
              <dt>{t.contact.callLabel}</dt>
              <dd><a class="phone-big" href={business.phoneHref}>{business.phoneDisplay}</a></dd>
            </div>
            <div>
              <dt>WhatsApp</dt>
              <dd><a href={wa} target="_blank" rel="noopener">{t.contact.waLabel} ↗</a></dd>
            </div>
            <div>
              <dt>{t.contact.igLabel}</dt>
              <dd><a href={business.instagram} target="_blank" rel="noopener">{business.instagramHandle} ↗</a></dd>
            </div>
          </dl>
        </div>

        <form class="wa-form" data-wa-form data-number={business.whatsapp}
          data-greeting={t.contact.form.greeting}
          data-l-name={t.contact.form.labels.name} data-l-area={t.contact.form.labels.area}
          data-l-job={t.contact.form.labels.job} data-l-msg={t.contact.form.labels.msg}>
          <h3 class="h3">{t.contact.form.title}</h3>
          <div class="field-row">
            <label>
              <span>{t.contact.form.name}</span>
              <input name="name" autocomplete="name" />
            </label>
            <label>
              <span>{t.contact.form.area}</span>
              <input name="area" placeholder={t.contact.form.areaPh} autocomplete="address-level2" />
            </label>
          </div>
          <label>
            <span>{t.contact.form.job}</span>
            <select name="job">
              {t.contact.form.jobs.map((j) => <option>{j}</option>)}
            </select>
          </label>
          <label>
            <span>{t.contact.form.msg}</span>
            <textarea name="msg" rows="4" placeholder={t.contact.form.msgPh}></textarea>
          </label>
          <button class="btn btn-terra" type="submit">{t.contact.form.submit} ↗</button>
          <p class="form-note">{t.contact.form.note}</p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <Logo />
      <p>{t.footer.line}</p>
      <p class="muted">{business.base} · <a href={business.phoneHref}>{business.phoneDisplay}</a> · {t.footer.rights}</p>
    </div>
  </footer>

  <div class="sticky-bar" aria-label={t.nav.contact}>
    <a href={business.phoneHref}>{t.sticky.call}</a>
    <a class="wa" href={wa} target="_blank" rel="noopener">{t.sticky.wa}</a>
  </div>

  <script>
    import '../scripts/main.ts';
  </script>
</Base>
