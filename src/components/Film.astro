---
// FILM — the same Bodrum house, photographed at every stage of the job, scrubbed by scroll:
// blueprint → weathered (Keşif) → scaffolding & scraping (Hazırlık) → insulation boards → base render (Yalıtım)
// → whitewashed (Boya) → dusk (final). Frames live in public/film/, all 2000×1116 and aligned to the same house.
// Each frame fades in over its [in] window on a 0–12 film clock; data-map turns scroll progress into that clock.
import Photo from './Photo.astro';
import { business, copy, type Lang } from '../content';
import { img } from '../images';
import { url } from '../url';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const f = t.film;
const n = f.notes;
const wa = `https://wa.me/${business.whatsapp}?text=${encodeURIComponent(t.contact.form.greeting)}`;

// name, top-of-frame sky colour (fills the space above the photo on tall screens), fade-in window
const frames: [string, string, [number, number]][] = [
  ['00-cizim', '#103260', [0, 0]],
  ['01-eski', '#bcdaed', [1, 1.8]],
  ['02-hazirlik', '#bcdaed', [3.3, 4.1]],
  ['03-yalitim', '#bcdaed', [5.6, 6.4]],
  ['04-siva', '#bcdaed', [7, 7.7]],
  ['05-bitmis', '#bcdaed', [8.4, 9.4]],
  ['06-aksam', '#9d9ab1', [10.2, 11]],
];
// Caption windows on the film clock, matched to the frames above.
const sceneTimes = [[1.4, 3.3], [3.6, 5.6], [6, 8.1], [8.5, 10.2]];
// Pins on the photo, in frame pixels (2000×1116).
const pins: { x: number; y: number; from: number; to: number; b?: string; text: string; warn?: boolean }[] = [
  { x: 1186, y: 1040, from: 1.5, to: 3.4, b: n.width[0], text: n.width[1] },
  { x: 868, y: 640, from: 1.65, to: 3.4, b: n.height[0], text: n.height[1] },
  { x: 1830, y: 770, from: 1.8, to: 3.4, b: n.terrace[0], text: n.terrace[1] },
  { x: 1508, y: 600, from: 1.95, to: 3.4, text: n.leak, warn: true },
  { x: 1030, y: 650, from: 4, to: 5.6, text: n.blister, warn: true },
  { x: 1300, y: 470, from: 4.15, to: 5.6, text: n.crack, warn: true },
  { x: 1010, y: 700, from: 6.2, to: 8.1, b: n.board[0], text: n.board[1] },
  { x: 1250, y: 440, from: 7.2, to: 8.1, text: n.mesh },
  { x: 1760, y: 830, from: 9.3, to: 10.2, text: n.paint },
];
---
<section class="film" id="film" data-map="0:0,.08:1,.24:3.2,.42:5.4,.6:7.6,.78:9.8,1:12" aria-labelledby="hero-title">
  <div class="film__stage">
    <div class="film__box" role="img" aria-label={f.label}>
      <div class="film__push">
        {frames.map(([name, sky, [a, b]], k) => (
          <div class="film__frame" data-k={k} data-in={a} data-in-to={b} style={`--sky: ${sky}`}>
            <img
              src={url(`/film/${name}-2000.webp`)}
              srcset={`${url(`/film/${name}-1200.webp`)} 1200w, ${url(`/film/${name}-2000.webp`)} 2000w`}
              sizes="(max-aspect-ratio: 1/1) 220vw, 100vw"
              width="2000" height="1116" alt=""
              decoding="async"
              fetchpriority={k === 0 ? 'high' : 'low'}
            />
          </div>
        ))}
        <div class="film__pins" aria-hidden="true">
          {pins.map((p) => (
            <p class:list={['film__pin', p.warn && 'film__pin--warn', p.x > 1600 && 'film__pin--left']} data-x={p.x} data-y={p.y} data-from={p.from} data-to={p.to}>
              <span class="film__pin-dot"></span>
              <span class="film__pin-label">{p.b && <b>{p.b}</b>} {p.text}</span>
            </p>
          ))}
        </div>
      </div>
    </div>

    <div class="film__scrim" aria-hidden="true"></div>
    <div class="film__scrim film__scrim--light" aria-hidden="true"></div>

    <div class="wrap film__copy">
      <div class="film__scene film__scene--hero" data-from="0" data-to="1.1">
        <p class="kicker">{t.hero.kicker}</p>
        <h1 class="hero-title" id="hero-title">
          <span>{t.hero.titleA}</span>
          <span><em>{t.hero.titleEm}</em> {t.hero.titleB}</span>
        </h1>
        <p class="film__lede">{t.hero.lead}</p>
        <div class="hero-ctas">
          <a class="btn btn-terra" href={wa} target="_blank" rel="noopener">{t.hero.ctaPrimary}</a>
          <a class="link-arrow" href="#isler">{t.hero.ctaSecondary} <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      {f.scenes.map((s, i) => (
        <div class="film__scene" data-from={sceneTimes[i][0]} data-to={sceneTimes[i][1]} aria-hidden="true">
          <p class="kicker">{s.eyebrow}</p>
          <p class="film__title">{s.a}<br /><em>{s.em}</em></p>
          <p class="film__lede">{s.lead}</p>
        </div>
      ))}
      <div class="film__scene" data-from="10.6" data-to="99" aria-hidden="true">
        <p class="kicker">{f.final.eyebrow}</p>
        <p class="film__title">{f.final.a}<br /><em>{f.final.em}</em></p>
        <p class="film__lede">{f.final.lead}</p>
        <div class="hero-ctas">
          <a class="btn btn-terra" href={wa} target="_blank" rel="noopener" tabindex="-1">{t.hero.ctaPrimary}</a>
          <a class="link-arrow" href={business.phoneHref} tabindex="-1">{business.phoneDisplay}</a>
        </div>
      </div>
    </div>

    <figure class="film__photo" aria-hidden="true">
      <Photo src={img['demo-g-begonvil']} alt={f.photoAlt} sizes="240px" widths={[240, 480]} />
      <figcaption>{f.photoLabel}</figcaption>
    </figure>

    <p class="film__hint" aria-hidden="true">{f.scroll} <span>↓</span></p>
  </div>
</section>

<script>
  import '../scripts/film.ts';
</script>
