---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import '../styles/global.css';
import { business, copy, type Lang } from '../content';
import { img } from '../images';
import { getImage } from 'astro:assets';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];

const ogImage = await getImage({ src: img['hero-teras'], width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: business.name,
  telephone: '+905468527886',
  address: { '@type': 'PostalAddress', addressLocality: 'Turgutreis, Bodrum', addressRegion: 'Muğla', addressCountry: 'TR' },
  areaServed: 'Bodrum',
  sameAs: [business.instagram],
  knowsLanguage: ['tr', 'en'],
};
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#f3efe6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="tr" href={abs('/')} />
    <link rel="alternate" hreflang="en" href={abs('/en/')} />
    <link rel="alternate" hreflang="x-default" href={abs('/')} />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={abs(ogImage.src)} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_GB'} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>
